{
    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://*:5000"
            }
        }
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
