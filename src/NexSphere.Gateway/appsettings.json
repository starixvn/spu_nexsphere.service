{
    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://*:5000"
            }
        }
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ApiSettings": {
        "Issuer": "https://localhost:5002",
        "DataAccess": {
            "Secret": "secretJWTsigningKey@123-secretJWTsigningKey@123"
        },
        "Gateway": {
            "Secret": "secretJWTsigningKey@456-secretJWTsigningKey@123"
        }

    },
    "AuthApiSettings": {
        "Secret": "secretJWTsigningKey@456-secretJWTsigningKey@123",
        "Issuer": "https://localhost:5000"

    },
    "ServiceUrls": {
        "AuthAPI": "http://localhost:5050"
    },
    "Sentry": {
        "Dsn": "https://d59b5549b9474f3f8710af6de2e73907@sentry.nexdev.net/129",
        "IncludeRequestPayload": true,
        "SendDefaultPii": false,
        "MinimumBreadcrumbLevel": "Debug",
        "MinimumEventLevel": "Warning",
        "AttachStackTrace": true,
        "Debug": true,
        "DiagnosticsLevel": "Error"
    },
    "Routes": [
        {
            "UpstreamPathTemplate": "/authenticate",
            "UpstreamHttpMethod": [ "Post" ],
            "DownstreamPathTemplate": "/api/authenticate",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [
                {
                    "Host": "localhost",
                    "Port": 5002
                }
            ]
        },
        {
            "UpstreamPathTemplate": "/UseAgent/{size}",
            "UpstreamHttpMethod": [ "Get" ],
            "DownstreamPathTemplate": "/api/UseAgent/{size}",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [
                {
                    "Host": "localhost",
                    "Port": 5001
                }
            ],
            "AuthenticationOptions": {
                "AuthenticationProviderKey": "Bearer"
            },
            "RouteClaimsRequirement": {
                "customrole": "admin"
            }
        }
    ]
}
